diff --git a/net/arp.c b/net/arp.c
--- a/net/arp.c
+++ b/net/arp.c
@@ -25,9 +25,14 @@ ulong		arp_wait_timer_start;
 int		arp_wait_try;
 uchar	       *arp_tx_packet; /* THE ARP transmit packet */
 static uchar	arp_tx_packet_buf[PKTSIZE_ALIGN + PKTALIGN];
+ulong arp_timeout;
+int arp_retry_count;
 
 void arp_init(void)
 {
+	char* str_arp_timeout;
+    char* str_arp_retry_count;
+
 	/* XXX problem with bss workaround */
 	arp_wait_packet_ethaddr = NULL;
 	net_arp_wait_packet_ip.s_addr = 0;
@@ -35,6 +40,30 @@ void arp_init(void)
 	arp_wait_tx_packet_size = 0;
 	arp_tx_packet = &arp_tx_packet_buf[0] + (PKTALIGN - 1);
 	arp_tx_packet -= (ulong)arp_tx_packet % PKTALIGN;
+
+    /* Initialize ARP timeout */
+    str_arp_timeout = env_get("arptimeout");
+    if(str_arp_timeout) {
+        arp_timeout = simple_strtoul(str_arp_timeout, NULL, 0);
+        if(arp_timeout < 1000) {
+            printf("ARP timeout (%ld ms) too low, set min = 1000 ms\n", arp_timeout);
+            arp_timeout = 1000;
+        }
+    }
+    if(arp_timeout <= 0)
+        arp_timeout = CONFIG_ARP_TIMEOUT;
+
+    /* Initialize ARP retry count */
+    str_arp_retry_count = env_get("arpretrycount");
+    if(str_arp_retry_count) {
+        arp_retry_count = simple_strtol(str_arp_retry_count, NULL, 0);
+        if(arp_retry_count < 0) {
+            printf("ARP retry count max (%d) negative, set to 0\n", arp_retry_count);
+            arp_retry_count = 0;
+        }
+    }
+    if(arp_retry_count <= 0)
+        arp_retry_count = CONFIG_NET_RETRY_COUNT;
 }
 
 void arp_raw_request(struct in_addr source_ip, const uchar *target_ethaddr,
@@ -94,12 +123,18 @@ int arp_timeout_check(void)
 	t = get_timer(0);
 
 	/* check for arp timeout */
-	if ((t - arp_wait_timer_start) > CONFIG_ARP_TIMEOUT) {
+	if ((t - arp_wait_timer_start) > arp_timeout) {
 		arp_wait_try++;
 
-		if (arp_wait_try >= CONFIG_NET_RETRY_COUNT) {
+		if (arp_wait_try >= arp_retry_count) {
 			puts("\nARP Retry count exceeded; starting again\n");
-			arp_wait_try = 0;
+
+            /* no arp request pending now */
+            arp_wait_try = 0;
+			net_arp_wait_packet_ip.s_addr = 0;
+			arp_wait_tx_packet_size = 0;
+			arp_wait_packet_ethaddr = NULL;
+
 			net_set_state(NETLOOP_FAIL);
 		} else {
 			arp_wait_timer_start = t;
@@ -211,6 +246,7 @@ void arp_receive(struct ethernet_hdr *et, struct ip_udp_hdr *ip, int len)
 			net_send_packet(net_tx_packet, arp_wait_tx_packet_size);
 
 			/* no arp request pending now */
+			arp_wait_try = 0;
 			net_arp_wait_packet_ip.s_addr = 0;
 			arp_wait_tx_packet_size = 0;
 			arp_wait_packet_ethaddr = NULL;

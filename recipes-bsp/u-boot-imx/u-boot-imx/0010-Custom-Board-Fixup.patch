diff --git a/common/board_f.c b/common/board_f.c
index 41283b21fd0..9a580802b60 100644
--- a/common/board_f.c
+++ b/common/board_f.c
@@ -54,6 +54,12 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
+#ifdef CONFIG_OF_BOARD_FIXUP
+#ifdef CONFIG_OF_CUSTOM_BOARD_FIXUP
+extern int custom_board_fix_fdt(void *rw_fdt_blob);
+#endif
+#endif
+
 /*
  * Why is gd allocated a register? Prior to reloc it might be better to
  * just pass it around to each function in this file?
@@ -743,7 +749,20 @@ static int setup_reloc(void)
 #if CONFIG_IS_ENABLED(OF_BOARD_FIXUP)
 static int fix_fdt(void)
 {
+#ifdef CONFIG_OF_CUSTOM_BOARD_FIXUP
+	int r1, r2;
+	r1 = board_fix_fdt((void *)gd->fdt_blob);
+	r2 = custom_board_fix_fdt((void*)gd->fdt_blob);
+
+	if(r1)
+		return(r1);
+	if(r2)
+		return(r2);
+
+	return(0);
+#else
 	return board_fix_fdt((void *)gd->fdt_blob);
+#endif
 }
 #endif
 

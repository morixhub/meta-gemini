+	int ret;
+	unsigned int val;
+
+	ret = clk_prepare_enable(sgtl5000->mclk);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(sgtl5000->regmap, reg, &val);
+	clk_disable_unprepare(sgtl5000->mclk);
+
+	return ret < 0 ? 0 : val;

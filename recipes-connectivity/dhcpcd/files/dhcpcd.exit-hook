#!/bin/bash

# Process events at OS level
if [ "$reason" = "STATIC" ]; then
    # If a static profile is assigned to the interface, then write a proper file
	if [ ! -z "$profile" ];	then
        echo $profile >> "/tmp/static_"$interface ;
	fi
elif [ "$reason" = "BOUND" ]; then
    # If a new address is being bound, then update data about last received interface configuration
    mkdir -p /data/.sys/dhcpcd ;
    echo "static ip_address="$new_ip_address > "/data/.sys/dhcpcd/last_"$interface ;
    echo "static subnet_mask="$new_subnet_mask >> "/data/.sys/dhcpcd/last_"$interface ;
    echo "static routers="$new_routers >> "/data/.sys/dhcpcd/last_"$interface ;

    # Refresh dhcpcd configuration file
    if [ -x /usr/bin/refresh_dhcpcd_conf.sh ]; then
        /usr/bin/refresh_dhcpcd_conf.sh ;
    fi

    # Update routers
    if [ -f /var/run/gw.$interface ]; then
        rm /var/run/gw.$interface ;
    fi
    for i in $new_routers ; do
        echo $i > /var/run/gw.$interface ;
    done

    # Trigger custom routing script, if any
    if [ -x /etc/network/if-up.d/custom-routing ]; then
        IFACE=$interface /etc/network/if-up.d/custom-routing ;
    fi
fi

# Process events at application level, if possible
if [ -f /app/dhcp.exit-hook.sh ]; then
    source /app/dhcp.exit-hook.sh ;
fi




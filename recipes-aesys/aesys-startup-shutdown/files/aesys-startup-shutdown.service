[Unit]
Description=Aesys management of system startup/shutdown

# Start only if first initialization has been completed
ConditionPathExists=!/data/.sys/firstinit.pending

[Service]
Type=oneshot
ExecStart=/sbin/aesys-startup.sh
ExecStop=/sbin/aesys-shutdown.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target